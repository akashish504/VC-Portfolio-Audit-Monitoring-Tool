# -------- STEP 1: Build React frontend (as 'builder') --------
    FROM node:20-alpine AS builder
    WORKDIR /app
    
    # Copy package files and install
    COPY package*.json ./
    RUN npm ci
    
    # Copy the rest of the source code and build
    COPY . .
    RUN npm run build
    
    # -------- STEP 2: Setup Production Server (Nginx) --------
    FROM nginx:stable-alpine
    
    # Install Doppler CLI
    RUN wget -q -t3 'https://packages.doppler.com/public/cli/rsa.8004D9FF50437357.key' -O /etc/apk/keys/cli@doppler-8004D9FF50437357.rsa.pub && \
        echo 'https://packages.doppler.com/public/cli/alpine/any-version/main' | tee -a /etc/apk/repositories && \
        apk add --no-cache doppler
    
    # Copy the built React app from the 'builder' stage
    # This assumes your build output folder is 'dist' (default for Vite)
    # If you use Create React App, change 'dist' to 'build'
    COPY --from=builder /app/dist /usr/share/nginx/html
    
    # Copy the custom Nginx config file (see file 2 below)
    COPY nginx.conf /etc/nginx/conf.d/default.conf.template
    
    # Copy the entrypoint script (see file 3 below)
    COPY entrypoint.sh /entrypoint.sh
    RUN chmod +x /entrypoint.sh
    
    # Expose Nginx default port
    EXPOSE 80
    
    # Set the entrypoint to run the app via Doppler
    ENTRYPOINT ["doppler", "run", "--fallback=doppler.encrypted.internal.json", "--"]
    
    # Run the entrypoint script, which will start Nginx
    CMD ["/entrypoint.sh"]
