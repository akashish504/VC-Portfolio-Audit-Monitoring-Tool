# Copy to .env and adjust. Required for local Postgres without SSL:
# POSTGRES_SSLMODE=disable

ENV=development
DEBUG=true
# Prefer OpenAI for LLM when OPENAI_API_KEY is set (see src/llm/config.py resolve_llm_provider).
LOCAL_DEV=true
# Server logs: DEBUG | INFO (default) | WARNING | ERROR — INFO shows API access lines (src.http) and app INFO
# LOG_LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tailoredAI
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=peakxv_pr_tool
POSTGRES_SSLMODE=disable

CORS_ORIGIN=http://localhost:3000
CSRF_SECRET_KEY=change-me-to-a-long-random-string

# Authorization: tenant id from JWT (Okta custom claim). Rows are scoped per tenant_id in DB.
# AUTHZ_TENANT_CLAIM=tenant_id
# AUTHZ_REQUIRED_GROUPS=
# For production, require a tenant claim: AUTHZ_ALLOW_DEFAULT_TENANT=false
# AUTHZ_ALLOW_DEFAULT_TENANT=true
# AUTHZ_DEFAULT_TENANT=default
# INFRA_PROBE_SECRET=long-random-for-load-balancer-probes

# FX: FX_USE_MOCK=true forces bundled rates. Omit XE_ACCOUNT_ID/XE_API_KEY and live mode also falls back to mock.
# FX_USE_MOCK=true
# XE_CONVERT_URL=https://xecdapi.xe.com/v1/convert_from.json/
# XE_ACCOUNT_ID=
# XE_API_KEY=
# Optional comma-separated ISO codes batched as XE ``to=`` (default: USD,EUR,INR,GBP,JPY,... majors)
# FX_QUOTE_CURRENCIES=USD,EUR,INR,GBP,JPY,CAD,AUD

# Optional: AWS — S3 region.
# Deployments: IRSA / instance profile (default boto3 chain). Do not set access keys on pods.
# LOCAL_DEV=true: optional AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN for local Bedrock/S3.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Primary bucket for org charts + audit uploads (also Bedrock batch staging: JSONL + PDF copies under BEDROCK_BATCH_S3_PREFIX)
# S3_BUCKET=
# 12-digit AWS account that owns the bucket (required for Bedrock batch S3 in/out in some cross-account setups)
# S3_BUCKET_OWNER_ACCOUNT_ID=
#
# Bucket for draft-email attachments
# AWS_S3_EMAIL_BUCKET=

# LLM (document extraction, org-chart, etc.)
#
# Local: LOCAL_DEV=true + OPENAI_API_KEY — document extraction (audit + org-chart) always uses OpenAI (no Bedrock batch).
# Deploy: unset LOCAL_DEV; Bedrock file extraction uses batch (IRSA). Optional local keys only when LOCAL_DEV for S3.
#
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o
#
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
# BEDROCK_REGION=
# Legacy (ignored by app): AWS_BEARER_TOKEN_BEDROCK=
# Image+text financial-statement extraction pipeline (ON by default; set false to force legacy pass):
# EXTRACTION_USE_IMAGE_PIPELINE=true
# Band-aware deterministic-first pass-2 mapper (ON by default; set false to force the legacy LLM
# tree mapper). Places metric-critical lines by source band + arithmetic role (no cross-band
# mis-tagging), drops out-of-scope statements (SOCE / notes), and uses the LLM only for residual
# lines under band/role validation. Falls back to the LLM mapper automatically on any error.
# EXTRACTION_USE_DETERMINISTIC_MAPPER=true
# EXTRACTION_RENDER_TARGET_PX=2000
# EXTRACTION_TEXTRACT_ENABLED=true   # Textract recovers digits from scanned statements
# TEXTRACT_REGION=us-east-1          # Textract is absent in some regions (e.g. eu-north-1)
# Optional: Bedrock/OpenAI HTTP timeout (seconds) for document LLM extraction (org-chart + audit files)
# ORG_CHART_LLM_TIMEOUT=120
# Read timeout for Bedrock Converse calls that upload a PDF inline (default 360 s = 6 min).
# Increase if large multi-page PDFs still time out.
# BEDROCK_PDF_LLM_TIMEOUT=360
#
# Org-chart on Bedrock: batch inference (CreateModelInvocationJob). Audit sync Converse uses the same IAM credentials.
# IAM role ARN trusted by Bedrock to read/write your S3 batch folders — see AWS docs “Create a service role for batch inference”.
# BEDROCK_BATCH_ROLE_ARN=arn:aws:iam::ACCOUNT:role/your-bedrock-batch-role
# Optional: prefix under S3_BUCKET for staging input.jsonl + PDF copy + output (default bedrock-batch)
# BEDROCK_BATCH_S3_PREFIX=bedrock-batch
# BEDROCK_BATCH_POLL_INTERVAL_SECONDS=15
# BEDROCK_BATCH_TIMEOUT_HOURS=24
# Optional: assume this role for Bedrock control-plane API (CreateModelInvocationJob) when calling from another account
# BEDROCK_CROSS_ACCOUNT_ROLE_ARN=
#
# Bedrock Runtime Converse (deployment, LOCAL_DEV=false): default is STS assume_role of
# arn:aws:iam::<caller-account>:role/bedrock-caller-devapp-role (caller account via BEDROCK_RUNTIME_CALLER_ACCOUNT_ID or STS).
# Override the full ARN, or cross-account ARN, explicitly:
# BEDROCK_RUNTIME_ASSUME_ROLE_ARN=
# BEDROCK_RUNTIME_CALLER_ACCOUNT_ID=
# BEDROCK_RUNTIME_CALLER_ROLE_NAME=bedrock-caller-devapp-role
